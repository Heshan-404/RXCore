{
  "build": {
    "distDir": "..\\ui",
    "devPath": "..\\ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Ruve Desktop",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.ruve.desktop",
      "icon": [
        "icons\\32x32.png",
        "icons\\128x128.png",
        "icons\\128x128@2x.png",
        "icons\\icon.icns",
        "icons\\icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Ruve Desktop",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ]
  }
}
